<?php

namespace HB9HCR;

$ops = $this->container->operations;

$m = (object)[
    'ops' => count($ops),
    'ref' => 0,
    'set' => 0,
];

foreach ($ops as $o) {
    $m->ref += $o->ref;
    $m->set += count($o->set);
}

$obs = $this->container->adab->collection(['reference' => 'A%']);

$c = function (object $o) {
    $c = match($o) {
        'F' == $o->reference[0] => 'yellow',
        'T' == $o->reference[0] => 'green',
        default => '#ff6052',
    };

    $c = $o->bota ? '#b14137ff' : $c;
    $c = 0 < $o->qso_count ? '#2a81cbff' : $c;

    return $c;
};

