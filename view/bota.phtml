<?php
namespace HB9HCR;

use DateTime, Exception;

function bunkers(object $item) {
    preg_match_all('#B/(HB-\d{4})#', $item->qslmsg, $m);
    return $m[1];
}

if ($this->post->has('bota-refresh')) {
    $options = json_decode(base64_decode($this->post->get('bota-refresh')));
    $this->container->bota->{$options->method}($options->options ?? (object)[]);
    $this->container->router->redirect();
}

if ($this->post->has('log-upload')) {
    $data = $this->container->adif->parse($_FILES['log-file']['tmp_name']);
    $data = array_reverse($data);

    switch ($this->post->get('log-upload')) {
        case 'today':
            $data = array_filter($data, function ($item) {
                return date('Ymd') == $item->qso_date;
            });
            break;

        case 'last':
            $data = array_slice($data, $this->post->get('log-last') * -1);
            break;

        default:
    }

    $this->container->session->set('log', $data);
    $this->container->router->redirect();
}

if ($this->post->has('log-delete')) {
    $log = $this->container->session->get('log');
    unset($log[$this->post->get('log-delete')]);
    $this->container->session->set('log', array_values($log));
    $this->container->router->redirect();
}

if ($this->post->has('log-clear')) {
    $this->container->session->clear('log');
    $this->container->router->redirect();
}

if ($this->post->has('log-upsert')) {
    $log = $this->container->session->get('log');
    $this->container->adif->insert($log);
    $this->container->session->clear('log');
    $this->container->router->redirect();
}

if ($this->post->has('log-push')) {
    try {
        $log = $this->container->session->get('log');
        $this->container->bota->pushLogs($log);
        $this->container->adif->insert($log);
        $this->container->session->clear('log');
        $this->container->router->redirect();
    }
    catch (Exception $e) {
        var_dump($e->getMessage());
    }
}

if ($this->post->has('adab-upsert')) {
    $this->container->adab->upsert($this->post);
    $this->container->router->redirect();
}

$log = $this->container->session->get('log');

