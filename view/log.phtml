<?php

$logs = $this->container->logs;

?>
<?php foreach ($logs as $log): ?>
    <h3>§ <?= strtok($log->getBaseName(), '-') ?> Log</h3>
    <?php $content = file($log->getRealpath()) ?>
    <table class="table table-hover">
        <thead>
            <tr>
                <th><?= $log->getBaseName() ?></th>
            </tr>
        </thead>
        <tbody>
        <?php foreach (array_reverse(array_slice($content, -10)) as $line): ?>
            <tr>
                <td style="white-space:wrap"><?= trim($line) ?></td>
            </tr>
        <?php endforeach ?>
        </tbody>
    </table>
<?php endforeach ?>