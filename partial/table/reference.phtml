            <td class="<?= $c->complete($l) ? 'opacity-50' : '' ?> text-end"><?= $r->qso_cw ?></td>
            <td class="<?= $c->complete($l) ? 'opacity-50' : '' ?> text-end"><?= $r->qso_ssb ?></td>
