            <th class="text-end">CW</th>
            <th class="text-end">SSB</th>
        </tr>
    </thead>
    <?php foreach ($this->operation->location as $l): ?>
    <tbody>
        <?php foreach ($l->reference as $i => $r): ?>
        <tr>
            <?php if (0 == $i): ?>
            <td rowspan="<?= count($l->reference) ?>" class="pe-3 location">
                <p class="h6 fw-bold m-0 position-relative">
                    <?= $l->name ?>
                    <?php if ($c->complete($l)): ?>
                    <span class="bravo-zulu">bravo zulu</span>
                    <?php endif ?>
                </p>
                <p class="opacity-50 m-0"><?= $c->last($l) ?? 'planned' ?></p>
                <p class="opacity-50 fw-bold m-0"><?= implode(' ', $l->also ?? []) ?></p>
            </td>
            <?php endif ?>
            <td class="d-none d-md-table-cell <?= $c->complete($l) ? 'opacity-50' : '' ?>"><?= $r->adab ?></td>
            <td class="<?= $c->complete($l) ? 'opacity-50' : '' ?>"><?= $r->bota ?></td>
