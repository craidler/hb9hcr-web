<?php

$c = $this->container->campaign;

?>
<table class="table align-middle">
    <thead>
        <tr>
            <th>Location</th>
            <th class="d-none d-md-table-cell">ADAB</th>
            <th>BOTA</th>
            <th class="d-none d-md-table-cell">Type
